[configuration]
entry_symbol = "lightsaber_library_init"
compatibility_minimum = "4.6"
android_aar_plugin = false

[libraries]
android.debug.arm64 = "res://bin/android/arm64/liblightsaber.so"
android.release.arm64 = "res://bin/android/arm64/liblightsaber.so"
linux.debug.x86_64 = "res://bin/linux/x86_64/liblightsaber.so"
linux.release.x86_64 = "res://bin/linux/x86_64/liblightsaber.so"
