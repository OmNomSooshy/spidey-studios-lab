; Quest 3 mixed-reality SmoothSwing prototype. Build-time tooling downloads the
; pinned Godot OpenXR Vendors addon and embeds the pinned single-font archive.
config_version=5

[application]
config/name="Project Lightsaber — Quest"
config/description="Standalone Quest 3 Proffie-derived SmoothSwing MR test"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=1600
window/size/resizable=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 0)

[xr]
openxr/enabled=true
openxr/environment_blend_mode=2
openxr/extensions/meta/passthrough=true
openxr/default_action_map="res://openxr_action_map.tres"
